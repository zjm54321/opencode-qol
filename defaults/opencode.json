{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "policies": [
    { "action": "provider.use", "resource": "opencode", "effect": "deny" }
  ],
  "agents": {
    "plan": { "disabled": true },
    "build": { "disabled": true },
    "general": { "disabled": true },
    "explore": { "disabled": true }
  },
  "update": "disable",
  "disabled_providers": [
    "opencode"
  ],
  "permission": {
    "external_directory": {
      "*": "ask",
      "/etc/nixos/**": "allow",
      "/nix/store/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "compaction": {
    "auto": false
  },
  "experimental": {
    "todo": true
  }
}
