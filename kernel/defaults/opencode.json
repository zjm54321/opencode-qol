{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "session": { "sidebar": "show" },
  "agents": {
    "plan": { "disabled": true },
    "build": { "disabled": true },
    "general": { "disabled": true },
    "explore": { "disabled": true }
  },
  "update": "disable",
  "permission": {
    "external_directory": {
      "*": "ask",
      "/etc/nixos/**": "allow",
      "/nix/store/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "compaction": {
    "auto": false
  },
  "experimental": {
    "todo": true
  }
}
