+        let (reply, duplicate) = bounded(1);
+        actor.actor_tx.send(ActorMessage::Stop { reply }).unwrap();
+        let state = actor_barrier(&actor).info;
+        assert!(state.killed);
+        assert!(state.termination_error.is_none());
+        assert_eq!(attempts.load(Ordering::SeqCst), 2);
