+    #[derive(Clone, Debug)]
+    struct FailOnceKiller {
+        attempts: Arc<std::sync::atomic::AtomicUsize>,
+    }
+
+    impl ChildKiller for FailOnceKiller {
+        fn kill(&mut self) -> io::Result<()> {
+            if self.attempts.fetch_add(1, std::sync::atomic::Ordering::SeqCst) == 0 {
+                return Err(io::Error::other("injected kill failure"));
+            }
+            Ok(())
+        }
+        fn clone_killer(&self) -> Box<dyn ChildKiller + Send + Sync> {
+            Box::new(self.clone())
+        }
+    }
+
+    #[derive(Clone, Debug)]
+    struct RecordingKiller(Arc<std::sync::atomic::AtomicUsize>);
+
+    impl ChildKiller for RecordingKiller {
+        fn kill(&mut self) -> io::Result<()> {
+            self.0.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
