+        let failed = actor.request(|reply| ActorMessage::Stop { reply }).unwrap_err();
+        assert!(failed.to_string().contains("stop termination failed: injected kill failure"));
+        let state = actor_barrier(&actor).info;
+        assert!(!state.killed);
