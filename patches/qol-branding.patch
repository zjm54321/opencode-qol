@@ -1,9 +1,42 @@
 export const logo = {
   left: ["                   ", "█▀▀█ █▀▀█ █▀▀█ █▀▀▄", "█__█ █__█ █^^^ █__█", "▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀~~▀"],
   right: ["             ▄     ", "█▀▀▀ █▀▀█ █▀▀█ █▀▀█", "█___ █__█ █__█ █^^^", "▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀"],
 }
 
 export const go = {
   left: ["    ", "█▀▀▀", "█_^█", "▀▀▀▀"],
   right: ["    ", "█▀▀█", "█__█", "▀▀▀▀"],
 }
+
+// OpenCode QoL edition mark: three small lowercase letters set beside the
+// official wordmark (assets/branding/opencode-qol-logo.png in opencode-qol).
+export const edition = "qol"
+const suffix = `-${edition}`
+
+// Display-only version label. The build keeps the real upstream version for
+// update checks, service compatibility and state; only what users read gains
+// a single "-qol", so a future core bump shows its own base version.
+export function qolVersion(version: string) {
+  const base = version.trim().replace(/^v(?=\d)/, "")
+  if (!base) return base
+  return base.endsWith(suffix) ? base : base + suffix
+}
+
+export function qolVersionLabel(version: string) {
+  const value = qolVersion(version)
+  return /^\d/.test(value) ? `v${value}` : value
+}
+
+export type EditionPlacement = "beside" | "corner" | "none"
+
+// "beside": after the last wordmark row, one cell gap, when the row fits.
+// "corner": inside the free top-right cells of the wordmark's ascender row.
+export function editionPlacement(input: { columns: number; wordmark: number; corner?: string }): EditionPlacement {
+  if (input.wordmark + 1 + edition.length <= input.columns) return "beside"
+  if (input.corner && input.corner.endsWith(" ".repeat(edition.length + 1))) return "corner"
+  return "none"
+}
+
+export function editionCorner(line: string) {
+  return line.slice(0, line.length - edition.length)
+}
