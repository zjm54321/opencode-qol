diff --git a/packages/tui/src/logo.ts b/packages/tui/src/logo.ts
--- a/packages/tui/src/logo.ts
+++ b/packages/tui/src/logo.ts
@@ -1,9 +1,22 @@
 export const logo = {
   left: ["                   ", "█▀▀█ █▀▀█ █▀▀█ █▀▀▄", "█__█ █__█ █^^^ █__█", "▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀~~▀"],
   right: ["             ▄     ", "█▀▀▀ █▀▀█ █▀▀█ █▀▀█", "█___ █__█ █__█ █^^^", "▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀"],
 }

 export const go = {
   left: ["    ", "█▀▀▀", "█_^█", "▀▀▀▀"],
   right: ["    ", "█▀▀█", "█__█", "▀▀▀▀"],
 }
+
+const suffix = "-qol"
+
+export function qolVersion(version: string) {
+  const base = version.trim().replace(/^v(?=\d)/, "")
+  if (!base) return base
+  return base.endsWith(suffix) ? base : base + suffix
+}
+
+export function qolVersionLabel(version: string) {
+  const value = qolVersion(version)
+  return /^\d/.test(value) ? `v${value}` : value
+}
