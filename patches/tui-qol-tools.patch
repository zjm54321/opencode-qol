+// OpenCode QoL: dedicated rows for the built-in image and session-reader tools.
+function QolTool(props: ToolProps) {
+  const theme = useTheme()
+  const pathFormatter = usePathFormatter()
+  const [expanded, setExpanded] = createSignal(false)
+  const summary = createMemo(() =>
+    qolToolSummary({
+      tool: props.tool,
+      status: props.part.state.status,
+      input: props.input,
+      metadata: props.metadata,
+      output: props.output,
+    }),
+  )
+  const prompt = createMemo(() => stringValue(props.input.prompt))
+  const lines = createMemo(() =>
+    (summary()?.lines ?? []).map((line) =>
+      line.startsWith("↳ Saved ") ? `↳ Saved ${pathFormatter.format(line.slice("↳ Saved ".length))}` : line,
+    ),
+  )
+  return (
+    <>
+      <InlineTool
+        icon={summary()?.icon ?? "⚙"}
+        color={summary()?.failed ? theme.text.feedback.error.base : undefined}
+        spinner={summary()?.running}
+        pending={summary()?.title ?? props.tool}
+        complete={true}
+        part={props.part}
+        onClick={prompt() ? () => setExpanded((value) => !value) : undefined}
+      >
+        {summary()?.title ?? props.tool}
+      </InlineTool>
+      <For each={lines()}>
+        {(line) => (
+          <box paddingLeft={3}>
+            <text
+              paddingLeft={3}
+              wrapMode="none"
+              truncate
+              fg={summary()?.failed ? theme.text.feedback.error.base : theme.text.muted}
+            >
+              {line}
+            </text>
+          </box>
+        )}
+      </For>
+      <Show when={expanded() && prompt()}>
+        {(value) => (
+          <box paddingLeft={3 + INLINE_TOOL_ICON_WIDTH} flexDirection="row">
+            <text flexShrink={0} fg={theme.text.muted}>
+              prompt:{" "}
+            </text>
+            <text flexGrow={1} wrapMode="word" fg={theme.text.base}>
+              {value()}
+            </text>
+          </box>
+        )}
+      </Show>
+    </>
+  )
+}
