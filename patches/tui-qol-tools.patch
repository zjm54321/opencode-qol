diff --git a/packages/tui/src/util/qol-tool-display.ts b/packages/tui/src/util/qol-tool-display.ts
new file mode 100644
--- /dev/null
+++ b/packages/tui/src/util/qol-tool-display.ts
@@ -0,0 +1,256 @@
+// OpenCode QoL: display summaries for the built-in image and session-reader tools.
+// Pure helpers shared by the session view and `opencode run`; keep this file free of imports.
+
+export const QOL_IMAGE_TOOLS: readonly string[] = ["image_gen", "image_gen_nano"]
+export const QOL_SESSION_TOOLS: readonly string[] = ["session_list", "session_read", "session_diff"]
+export const QOL_TOOL_DISPLAYS: readonly string[] = [...QOL_IMAGE_TOOLS, ...QOL_SESSION_TOOLS]
+
+export const QOL_IMAGE_ICON = "▣"
+export const QOL_READ_ICON = "→"
+export const QOL_SEARCH_ICON = "✱"
+
+const TITLE_WIDTH = 40
+const MODEL_WIDTH = 32
+const QUERY_WIDTH = 32
+const ERROR_WIDTH = 120
+const SAVED_LINES = 2
+
+export type QolToolSummary = {
+  icon: string
+  /** Main row text: spinner label while running, final summary afterwards. */
+  title: string
+  /** Supplementary rows, already prefixed with "↳ ". Paths stay raw so callers can format them. */
+  lines: string[]
+  /** The tool returned an error payload as normal content (legacy image results). */
+  failed: boolean
+  running: boolean
+}
+
+type Dict = Record<string, unknown>
+
+function record(value: unknown): Dict {
+  return value && typeof value === "object" && !Array.isArray(value) ? (value as Dict) : {}
+}
+
+function str(value: unknown): string | undefined {
+  return typeof value === "string" && value.trim() ? value.trim() : undefined
+}
+
+function count(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isInteger(value) && value >= 0 ? value : undefined
+}
+
+function plural(n: number, word: string) {
+  return `${n} ${word}${n === 1 ? "" : "s"}`
+}
+
+function cellWidth(char: string) {
+  const code = char.codePointAt(0) ?? 0
+  if (code < 0x1100) return 1
+  if (
+    code <= 0x115f ||
+    (code >= 0x2e80 && code <= 0xa4cf) ||
+    (code >= 0xac00 && code <= 0xd7a3) ||
+    (code >= 0xf900 && code <= 0xfaff) ||
+    (code >= 0xfe30 && code <= 0xfe4f) ||
+    (code >= 0xff00 && code <= 0xff60) ||
+    (code >= 0xffe0 && code <= 0xffe6) ||
+    (code >= 0x1f300 && code <= 0x1faff) ||
+    (code >= 0x20000 && code <= 0x3fffd)
+  )
+    return 2
+  return 1
+}
+
+/** Collapses whitespace and truncates to a terminal cell budget with an ellipsis. */
+export function clipText(value: string, width: number) {
+  const text = value.replace(/\s+/g, " ").trim()
+  let used = 0
+  let out = ""
+  for (const char of text) {
+    const next = cellWidth(char)
+    if (used + next > width) return `${out.replace(/\s+$/, "")}…`
+    used += next
+    out += char
+  }
+  return out
+}
+
+function quoted(value: string, width: number) {
+  return `"${clipText(value, width)}"`
+}
+
+function joined(parts: readonly (string | undefined)[]) {
+  return parts.filter((part): part is string => Boolean(part)).join(" · ")
+}
+
+function settledStatus(status: string) {
+  return status !== "streaming" && status !== "running"
+}
+
+/** Legacy image results return `{"status":"error",...}` as normal content. */
+function imageErrorPayload(output: string) {
+  const text = output.trim()
+  if (!text.startsWith("{")) return
+  try {
+    const value = record(JSON.parse(text))
+    if (value.status !== "error") return
+    return { code: str(value.error_code), message: str(value.message) }
+  } catch {
+    return
+  }
+}
+
+function markdownImages(output: string) {
+  return Array.from(output.matchAll(/!\[[^\]]*\]\(([^)\s]+)\)/g), (match) => match[1])
+}
+
+function savedLines(paths: readonly string[]) {
+  const lines = paths.slice(0, SAVED_LINES).map((file) => `↳ Saved ${file}`)
+  if (paths.length > SAVED_LINES) lines.push(`↳ +${paths.length - SAVED_LINES} more`)
+  return lines
+}
+
+export function qolImageSummary(input: {
+  tool: string
+  status: string
+  input: Dict
+  metadata: Dict
+  output?: string
+}): QolToolSummary {
+  const metadata = record(input.metadata)
+  const args = record(input.input)
+  const references = Array.isArray(args.referenced_image_paths) ? args.referenced_image_paths.length : 0
+  const recent = count(args.num_last_images_to_include) ?? 0
+  // The OpenAI tool switches to its edit endpoint with references; Nano Banana uses them for continuity.
+  const editing =
+    typeof metadata.edited === "boolean"
+      ? metadata.edited
+      : input.tool === "image_gen" && references + recent > 0
+  const model = str(metadata.model) ?? str(args.model)
+  const aspect = str(metadata.aspect_ratio) ?? str(args.aspect_ratio)
+  const modelLabel = model ? clipText(model, MODEL_WIDTH) : undefined
+  const base = { icon: QOL_IMAGE_ICON, lines: [] as string[], failed: false, running: false }
+
+  if (!settledStatus(input.status))
+    return { ...base, running: true, title: joined([`${editing ? "Editing" : "Generating"} image…`, modelLabel]) }
+
+  if (input.status === "error") return { ...base, title: joined([`Image ${editing ? "edit" : "generation"} failed`, modelLabel]) }
+
+  const output = input.output ?? ""
+  const payload = imageErrorPayload(output)
+  if (payload)
+    return {
+      ...base,
+      failed: true,
+      title: joined([`Image ${editing ? "edit" : "generation"} failed`, payload.code]),
+      lines: payload.message ? [`↳ ${clipText(payload.message, ERROR_WIDTH)}`] : [],
+    }
+
+  const legacy = markdownImages(output)
+  const files = Array.isArray(metadata.files)
+    ? metadata.files.filter((file): file is string => typeof file === "string" && file.length > 0)
+    : legacy
+  // Only report a count the tool actually returned: metadata first, then real markdown image links.
+  const total = count(metadata.count) ?? (legacy.length > 0 ? legacy.length : undefined)
+  if (total === undefined) return { ...base, title: joined(["Image request finished", modelLabel]) }
+  if (total === 0) return { ...base, title: joined(["No image returned", modelLabel]) }
+  return {
+    ...base,
+    title: joined([`${editing ? "Edited" : "Generated"} ${plural(total, "image")}`, modelLabel, aspect]),
+    lines: savedLines(files),
+  }
+}
+
+function sessionLabel(metadata: Dict, args: Dict, output: string) {
+  const title = str(metadata.title) ?? str(/^# (.+)$/m.exec(output.split("\n", 1)[0] ?? "")?.[1])
+  if (title) return quoted(title, TITLE_WIDTH)
+  const id = str(metadata.sessionID) ?? str(args.sessionID)
+  return id ? clipText(id, TITLE_WIDTH) : undefined
+}
+
+function diffStats(metadata: Dict) {
+  const files = count(metadata.files)
+  if (files === undefined) return
+  if (files === 0) return "no changes"
+  const additions = count(metadata.additions)
+  const deletions = count(metadata.deletions)
+  const lines = additions !== undefined && deletions !== undefined ? ` (+${additions}/-${deletions})` : ""
+  return `${plural(files, "file")}${lines}`
+}
+
+export function qolSessionSummary(input: {
+  tool: string
+  status: string
+  input: Dict
+  metadata: Dict
+  output?: string
+}): QolToolSummary {
+  const metadata = record(input.metadata)
+  const args = record(input.input)
+  const output = input.output ?? ""
+  const running = !settledStatus(input.status)
+  const failed = input.status === "error"
+  const base = { lines: [] as string[], failed: false, running }
+
+  if (input.tool === "session_list") {
+    const search = str(metadata.search) ?? str(args.search)
+    const query = search ? quoted(search, QUERY_WIDTH) : undefined
+    const icon = QOL_SEARCH_ICON
+    if (running) return { ...base, icon, title: query ? `Searching sessions ${query}…` : "Listing sessions…" }
+    if (failed) return { ...base, icon, title: query ? `Couldn't search sessions ${query}` : "Couldn't list sessions" }
+    const total = count(metadata.count)
+    const more = str(record(metadata.cursor).next) ? "more available" : undefined
+    if (total === undefined) return { ...base, icon, title: query ? `Searched sessions ${query}` : "Listed sessions" }
+    return {
+      ...base,
+      icon,
+      title: joined([
+        query ? `Found ${plural(total, "session")} matching ${query}` : `Listed ${plural(total, "session")}`,
+        more,
+      ]),
+    }
+  }
+
+  const label = sessionLabel(metadata, args, output)
+  const mode = str(metadata.mode) ?? str(args.mode) ?? "summary"
+  const diff = input.tool === "session_diff" || mode === "diff"
+  const icon = QOL_READ_ICON
+  if (diff) {
+    if (running) return { ...base, icon, title: "Reading session diff…" }
+    if (failed) return { ...base, icon, title: joined(["Couldn't read session diff", label]) }
+    return { ...base, icon, title: joined(["Read session diff", label, diffStats(metadata)]) }
+  }
+
+  const verb = mode === "recent" ? "recent messages" : mode === "slice" ? "session history" : "session"
+  if (running) return { ...base, icon, title: `Reading ${verb}…` }
+  if (failed) return { ...base, icon, title: joined([`Couldn't read ${verb}`, label]) }
+  const total = count(metadata.count)
+  const more = str(record(metadata.cursor).next) ? "more available" : undefined
+  return {
+    ...base,
+    icon,
+    title: joined([`Read ${verb}`, label, total === undefined ? undefined : plural(total, "message"), more]),
+  }
+}
+
+export function qolToolSummary(input: {
+  tool: string
+  status: string
+  input: Dict
+  metadata: Dict
+  output?: string
+}): QolToolSummary | undefined {
+  if (QOL_IMAGE_TOOLS.includes(input.tool)) return qolImageSummary(input)
+  if (QOL_SESSION_TOOLS.includes(input.tool)) return qolSessionSummary(input)
+  return undefined
+}
+
+/** Neutral subject for callers that add their own outcome wording, such as "… failed". */
+export function qolToolSubject(tool: string) {
+  if (QOL_IMAGE_TOOLS.includes(tool)) return "Image generation"
+  if (tool === "session_list") return "Session list"
+  if (tool === "session_diff") return "Session diff"
+  if (tool === "session_read") return "Session read"
+  return tool
+}
